generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  
}



model Founder {
  id                  String   @id @default(uuid()) @db.Uuid
  email               String   @unique
  passwordHash        String
  name                String
  businessName        String?
  businessDescription String?
  timezone            String   @default("UTC")
  onboardingComplete  Boolean @default(false)
  onboardingState     Json?
  autonomySettings    Json     @default("{\"research\":{\"defaultTier\":\"NOTIFY_AND_ACT\"},\"marketing\":{\"defaultTier\":\"NOTIFY_AND_ACT\"},\"operations\":{\"defaultTier\":\"NOTIFY_AND_ACT\"},\"finance\":{\"defaultTier\":\"APPROVAL_REQUIRED\"}}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agents          Agent[]
  tasks           Task[]
  approvals       Approval[]
  connectors      Connector[]
  contextNotes    ContextNote[]
  activityLogs    ActivityLog[]
  chatSessions    ChatSession[]
  chatMessages    ChatMessage[]

  @@index([email])
}

model Agent {
  id            String @id
  name          String
  layer         String
  role          String
  responsibility String
  status        String @default("IDLE")
  founderId     String @db.Uuid
  metrics       Json   @default("{\"tasksCompleted\":0,\"tasksFailed\":0,\"avgResponseMs\":0}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([founderId])
  @@index([status])
}

model Task {
  id               String    @id @default(uuid()) @db.Uuid
  founderId        String    @db.Uuid
  layer            String
  agentId          String?
  title            String
  description      String
  status           String    @default("PENDING")
  riskTier         String    @default("NOTIFY_AND_ACT")
  priority         String    @default("MEDIUM")
  parentTaskId     String?   @db.Uuid
  metadata         Json?
  result           String?
  error            String?
  // Harness fields
  triggerType      String    @default("orchestrator_assigned")
  goal             String?
  contextRefs      String[]
  riskTierHint     String?
  deadline         DateTime?
  traceId          String?   @db.Uuid
  currentStep      Int       @default(0)
  maxSteps         Int       @default(8)
  modelOverride    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  founder  Founder    @relation(fields: [founderId], references: [id], onDelete: Cascade)
  agent    Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  approvals Approval[]
  steps    TaskStep[]
  traces   Trace[]

  @@index([founderId])
  @@index([status])
  @@index([layer])
  @@index([agentId])
  @@index([traceId])
}

model Event {
  id           String    @id @default(uuid()) @db.Uuid
  type         String
  publisher    String
  payload      Json
  timestamp    DateTime  @default(now())
  correlationId String? @db.Uuid

  @@index([type])
  @@index([timestamp])
  @@index([correlationId])
}

model EventSubscription {
  id               String   @id @default(uuid()) @db.Uuid
  subscriberAgentId String
  eventTypes       String[]
  createdAt         DateTime @default(now())

  @@index([subscriberAgentId])
}

model Approval {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @db.Uuid
  agentId      String
  layer        String
  action       String
  reasoning    String
  riskTier     String
  riskFactors  String[]
  status       String    @default("PENDING")
  resolution   String?
  editedAction String?
  founderId    String    @db.Uuid
  expiresAt    DateTime
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([status])
  @@index([expiresAt])
}

model Connector {
  id                 String    @id @default(uuid()) @db.Uuid
  founderId          String    @db.Uuid
  connectorName      String
  status             String    @default("DISCONNECTED")
  lastHealthCheck    DateTime?
  lastSuccessfulCall DateTime?
  authMetadata       Json?
  createdAt          DateTime  @default(now())

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([founderId, connectorName])
  @@index([founderId])
  @@index([status])
}

model ConnectorDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  displayName String
  description String
  icon        String   @default("🔌")
  authType    String   @default("OAUTH")
  layer       String   @default("CROSS_LAYER")
  scopes      String[] @default([])
  tools       String[] @default([])
  createdAt   DateTime @default(now())
}

model ContextNote {
  id                String   @id @default(uuid()) @db.Uuid
  founderId         String   @db.Uuid
  layer             String?
  category          String
  memoryType        String   @default("business_fact")
  content           String
  embeddingId       String?
  embedding         Unsupported("vector(1536)")?
  confidence        String   @default("inferred")
  status            String   @default("active")
  supersededBy      String?  @db.Uuid
  sourceAgentId     String?
  sourceTraceId     String?  @db.Uuid
  sourceTaskId      String?  @db.Uuid
  referenceCount    Int      @default(0)
  lastReferencedAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([category])
  @@index([memoryType])
  @@index([confidence])
  @@index([status])
  @@index([layer])
  @@index([lastReferencedAt])
  @@index([founderId, status])
  @@index([founderId, memoryType])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  founderId   String   @db.Uuid
  agentId     String?
  type        String
  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([timestamp])
  @@index([type])
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  founderId String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  founder Founder       @relation(fields: [founderId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([founderId])
}

model TaskStep {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  stepNumber  Int
  type        String
  input       Json?
  output      Json?
  toolCall    Json?
  toolResult  Json?
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepNumber])
  @@index([taskId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  founderId String   @db.Uuid
  sessionId String   @db.Uuid
  role      String
  content   String
  agentId   String?
  layer     String?
  metadata  Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  founder Founder      @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([sessionId])
}
model Trace {
  id          String    @id @default(uuid()) @db.Uuid
  originType  String
  originRef   String?
  founderId   String    @db.Uuid
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  status      String    @default("in_progress")
  createdAt   DateTime  @default(now())

  tasks Task[]
 spans Span[]

  @@index([founderId])
  @@index([status])
  @@index([startedAt])
}

model Span {
  id             String    @id @default(uuid()) @db.Uuid
  traceId        String    @db.Uuid
  parentSpanId   String?   @db.Uuid
  agentId        String?
  taskId         String?   @db.Uuid
  spanType       String
  status         String    @default("pending")
  inputSummary   String?
  outputSummary  String?
  fullPayloadRef String?
  tokensUsed     Int?
  costEstimate   Float?
  error          String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  trace Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([agentId])
  @@index([spanType])
  @@index([status])
  @@index([startedAt])
}

model EvalRun {
  id               String   @id @default(uuid()) @db.Uuid
  agentId          String
  testSetVersion   String
  totalTests       Int      @default(0)
  passedTests      Int      @default(0)
  failedTests      Int      @default(0)
  score            Float?
  passed           Boolean  @default(false)
  modelVersion     String?
  promptVersion    String?
  triggeredBy      String   @default("scheduled")
  createdAt        DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

model EvalTestCase {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String
  testSetVersion  String   @default("v1")
  name            String
  input           Json
  expectedOutput  Json?
  evalType        String   @default("golden")
  rubric          Json?
  createdAt       DateTime @default(now())

  @@unique([agentId, name])
  @@index([agentId])
}

model ScheduledAction {
  id              String    @id @default(uuid()) @db.Uuid
  founderId       String    @db.Uuid
  agentId         String
  layer           String
  goal            String
  cronExpression  String?
  runAt           DateTime?
  recurring       Boolean   @default(false)
  status          String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([founderId])
  @@index([status])
  @@index([nextRunAt])
}

model ConversationHistory {
  id              String   @id @default(uuid()) @db.Uuid
  founderId       String   @db.Uuid
  agentId         String
  role            String   // user, assistant, system
  content         String
  sessionId       String?
  taskId          String?
  traceId         String?
  createdAt       DateTime @default(now())

  @@index([founderId, agentId])
  @@index([sessionId])
  @@index([createdAt])
}
