# ===== SUPABASE =====
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key
SUPABASE_ANON_KEY=eyJhbG...your-anon-key

# ===== DATABASE (Supabase Postgres) =====
# From: Supabase Dashboard → Settings → Database → Connection string → URI (pooler port 5432)
# NOTE: URL-encode special chars in password (@ → %40, # → %23, etc.)
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ===== REDIS (local or Upstash) =====
REDIS_URL=redis://localhost:6379

# ===== AUTH =====
JWT_SECRET=your-32-char-random-string-here

# ===== ANTHROPIC (LLM) =====
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== SERVER =====
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== CONNECTORS (plug in as needed) =====
WHATSAPP_ACCESS_TOKEN=
TALLY_API_KEY=
GST_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_ADS_OAUTH_TOKEN=
META_ADS_ACCESS_TOKEN=
GA_OAUTH_TOKEN=
SLACK_BOT_TOKEN=
CALENDLY_TOKEN=
NOTION_TOKEN=
SHOPIFY_ACCESS_TOKEN=
INTERCOM_TOKEN=
TWITTER_OAUTH_TOKEN=
MAILCHIMP_KEY=
OPENAI_API_KEY=
