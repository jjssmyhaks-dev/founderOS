# ===== SUPABASE =====
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== REDIS (local or Upstash) =====
REDIS_URL=redis://localhost:6379

# ===== AUTH =====
JWT_SECRET=your-32-char-random-string-here

# ===== ANTHROPIC (LLM) =====
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== SERVER =====
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== CONNECTORS (plug in as needed) =====
# WhatsApp: https://developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
# Tally: https://tally.so/api-docs
TALLY_API_KEY=
# GST: https://gstapi.onlinesmsgst.com
GST_API_KEY=
# Razorpay: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Google Ads: https://cloud.google.com
GOOGLE_ADS_OAUTH_TOKEN=
# Meta Ads: https://developers.facebook.com
META_ADS_ACCESS_TOKEN=
# Google Analytics
GA_OAUTH_TOKEN=
# Slack
SLACK_BOT_TOKEN=
# Calendly
CALENDLY_TOKEN=
# Notion
NOTION_TOKEN=
# Shopify
SHOPIFY_ACCESS_TOKEN=
# Intercom
INTERCOM_TOKEN=
# X/Twitter
TWITTER_OAUTH_TOKEN=
# Mailchimp
MAILCHIMP_KEY=
# OpenAI (for embeddings)
OPENAI_API_KEY=
